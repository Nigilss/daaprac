import json
import urllib.request
import urllib.parse

OWNER = "Nigilss"
REPO = "daaprac"
BRANCH = "main"

API = (
    f"https://api.github.com/repos/{OWNER}/{REPO}"
    f"/git/trees/{BRANCH}?recursive=1"
)

def get_data(url):
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "BCA-DAA-Practical-Loader"}
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read().decode("utf-8")

try:
    data = json.loads(get_data(API))

    if "tree" not in data:
        raise Exception("Could not read repository files.")

    files = [
        item["path"] for item in data["tree"]
        if item["type"] == "blob"
        and not item["path"].split("/")[-1].lower().startswith("readme")
        and (
            item["path"].lower().endswith(".py")
            or "." not in item["path"].split("/")[-1]
        )
    ]

    if not files:
        print("No Python or extensionless practical files found.")
    else:
        print("\n===== YOUR DAA PRACTICALS =====")

        for i, name in enumerate(files, 1):
            print(f"{i}. {name}")

        choice = int(input("\nEnter practical number: "))

        if choice < 1 or choice > len(files):
            print("Invalid practical number.")
        else:
            filename = files[choice - 1]
            path = urllib.parse.quote(filename, safe="/")
            raw_url = (
                f"https://raw.githubusercontent.com/"
                f"{OWNER}/{REPO}/{BRANCH}/{path}"
            )

            source = get_data(raw_url)

            print("\nRunning:", filename, "\n")
            exec(compile(source, filename, "exec"),
                 {"__name__": "__main__"})

except Exception as error:
    print("\nError:", error)
    print("Check your internet connection and GitHub files.")
