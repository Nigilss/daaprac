arr = [10, 20, 30, 40, 50, 60, 70]

search = int(input("Enter the element to search: "))

low = 0
high = len(arr) - 1

found = False

while low <= high:
    mid = (low + high) // 2

    if arr[mid] == search:
        print("Element found at position:", mid + 1)
        found = True
        break

    elif search < arr[mid]:
        high = mid - 1

    else:
        low = mid + 1

if found == False:
    print("Element not found")

